# Server configuration
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins (required for cross-origin Netlify frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite database file path (set to a mounted persistent disk path on Render, e.g. /var/data/agrinexus.db)
DATABASE_PATH=./data/agrinexus.db

# JWT signing secret (REQUIRED in production, minimum 32 random characters)
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional initial bootstrap password for the seeded System Administrator account
# Leave blank to claim the System Administrator password once via the first-run UI setup form
ADMIN_BOOTSTRAP_PASSWORD=

# Demo mode MUST remain false in production
DEMO_MODE=false

# OTP & rate limiting settings
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10