# AgriNexus Environment Configuration
# Copy this file to .env and fill in your values

# JWT Secret Key - CHANGE THIS IN PRODUCTION (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_IN_PRODUCTION

# JWT Token expiration in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP Settings
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Demo mode: when true, OTPs are logged to console instead of sent via SMS
# In production, set to false and configure SMS_PROVIDER_*
DEMO_MODE=true

# SMS Provider (for production OTP delivery)
# SMS_PROVIDER_API_KEY=your_sms_api_key
# SMS_PROVIDER_SENDER_ID=AGRNXS
# SMS_PROVIDER_BASE_URL=https://api.smsprovider.com/v1

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=60

# Database
DATABASE_URL=sqlite:///agrinexus.db
